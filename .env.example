# Raw FIRMS CSVs: <DATA_DIR>/<sensor>/<sensor>_<year>_<Country>.csv
DATA_DIR=sample_data
# Comma-separated country names, or * for every country found in DATA_DIR
DATA_COUNTRIES=Greece
# Inclusive year range
DATA_YEARS=2001-2025
# ETL output (Parquet + calibration.json)
PROCESSED_DIR=data/processed
# Grid cell size in degrees (0.01 deg is about 1 km, the MODIS pixel)
GRID_RES_DEG=0.01
# API server
API_PORT=3001
# 1 = serve server/fixtures/*.json instead of querying DuckDB
USE_FIXTURES=1
