PORT=3001
HOST=0.0.0.0
# Relative paths resolve against the repository root, as in the ETL.
# Root of the ETL Parquet dataset (the ETL's OUTPUT_DIR); <ARCHIVE_DIR>/hotspots is read.
ARCHIVE_DIR=data/parquet
# Writable DuckDB file holding the live (NRT) rows, in the ETL hotspot schema.
LIVE_DB_PATH=data/live/live.duckdb
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire
# Set to false to disable background polling (ingest only via POST /api/live/ingest).
LIVE_POLLING=true
# Live rows are dropped once the archive covers their day, or after this many days at the latest.
LIVE_RETENTION_DAYS=30
# A paused mode (archive / forecast) returns to realtime after this many minutes unless the
# frontend renews it. 0 = stay paused until the frontend switches back.
LIVE_PAUSE_RESUME_MINUTES=60
