PORT=3001
HOST=0.0.0.0
# Writable DuckDB file for the live (NRT) feature. Kept apart from the read-only archive Parquet.
LIVE_DB_PATH=../data/live/live.duckdb
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire
# Set to false to disable background polling (ingest only via POST /api/live/ingest).
LIVE_POLLING=true
# Hotspots older than this are purged from the live DB; history belongs to the archive.
LIVE_RETENTION_DAYS=14
