# Copy to .env. Both the ETL and the API server read this file. Everything here is optional.

# ---- ETL (CLI flags override these: --countries, --years, --input, --output, --threads) ----
# Comma-separated FIRMS country names, or * for every country found in INPUT_DIR
DATA_COUNTRIES=Greece
# 2000-2025 | 2021 | 2012,2021 | *
DATA_YEARS=*
# Folder scanned recursively for FIRMS CSVs (<sensor>_<year>_<Country>.csv)
INPUT_DIR=sample_data
# Root of the Parquet dataset: hotspots/, harmonized/, calibration/ (the API reads the same folder).
# Point both at a world build, e.g. OUTPUT_DIR=data/parquet_global
OUTPUT_DIR=data/parquet

# ---- API server ----
API_PORT=3001
# auto     = use the Parquet dataset in OUTPUT_DIR if it exists, else the bundled sample responses
# parquet  = Parquet only (503 with a clear message if OUTPUT_DIR is empty)
# fixtures = always the sample responses (no DuckDB queries)
DATA_SOURCE=auto

# ---- Guard rails (defaults fit a laptop; raise them on a server with the world dataset) ----
# DuckDB memory cap; default is a third of RAM, between 1 and 4 GB
# DUCKDB_MEMORY_LIMIT=3GB
# DUCKDB_THREADS=4
# Spill folder when a query needs more than the memory cap
# DUCKDB_TEMP_DIR=data/.duckdb_tmp
# A query running longer than this is interrupted (HTTP 504)
# QUERY_TIMEOUT_MS=30000
# MAX_CONCURRENT_QUERIES=3
# Map grid: cells are coarsened (0.1 -> 0.25 -> 0.5 -> 1 deg ...) until a response fits this
# GRID_MAX_CELLS=20000
# POINTS_MAX=50000
# EXPORT_MAX_ROWS=1000000

# ---- Live FIRMS feed + forecast (/api/live, from the API_backend branch) ----
# Off by default: the archive API never depends on it. Needs internet (public FIRMS NRT files, no key).
LIVE_ENABLED=false
# Writable DuckDB file for the live rows (ETL hotspot schema); git-ignored under data/
# LIVE_DB_PATH=data/live/live.duckdb
# Seconds between FIRMS polls (conditional GETs, so unchanged files cost little). FIRMS updates a few times an hour.
LIVE_POLL_SECONDS=300
# Set to false to only ingest on demand (POST /api/live/ingest)
# LIVE_POLLING=true
# Live rows are dropped once the archive covers their day, or after this many days
# LIVE_RETENTION_DAYS=30
# A paused mode (archive / forecast) returns to realtime after this many minutes; 0 = stay paused
# LIVE_PAUSE_RESUME_MINUTES=60
# The live DuckDB instance runs next to the archive one: cap it
# LIVE_DUCKDB_MEMORY_LIMIT=2GB
# LIVE_DUCKDB_THREADS=2
