{
  "name": "harmonized-burning-calendar",
  "private": true,
  "type": "module",
  "workspaces": [
    "etl"
  ],
  "scripts": {
    "etl:download": "npm run download -w etl --",
    "etl:normalize": "npm run normalize -w etl --",
    "etl:harmonize": "npm run harmonize -w etl --",
    "etl:report": "npm run report -w etl --",
    "etl:all": "npm run etl:normalize && npm run etl:harmonize && npm run etl:report",
    "etl:download-world": "npm run download-world -w etl --"
  }
}
